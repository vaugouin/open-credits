# copy to review/.env on the VPS (git-ignored)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vaugouindb
# the review app: an account that can SELECT, INSERT, UPDATE and DELETE T_WC_OC_REVIEW (and read the T2S collections)
DB_USER=
DB_PASSWORD=
# the importer: its own account, oc_importer (doc/sql/OC-importer-grants.sql); a long random password, e.g. openssl rand -hex 24
IMPORT_DB_USER=oc_importer
IMPORT_DB_PASSWORD=
# every submission is credited to this contributor until uploads carry an identity
IMPORT_CONTRIBUTOR=vaugouin
